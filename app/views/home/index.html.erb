
<section class="home-hero">
  <div class="container home-hero-inner">
    <h1>Бронирование площадок для любых мероприятий</h1>

    <p>
      Конференции, семинары, деловые встречи и другие события
      в удобных и современных пространствах
    </p>

    <div class="hero-search">
      <%= form_with url: venues_path, method: :get, local: true,
                    class: "search-form" do |f| %>
        <div class="search-field">
          <%= home_icon :pin %>
          <div class="search-field-content">
            <%= f.label :city, "Город" %>
            
          </div>
        </div>

        <div class="search-field search-date">
          <%= home_icon :calendar %>
          <div class="search-field-content">
            <span class="search-field-label">Дата мероприятия</span>
            
          </div>
        </div>

        <div class="search-field">
          <%= home_icon :users %>
          <div class="search-field-content">
            <%= f.label :guests, "Количество гостей" %>
            
          </div>
        </div>

        <%= f.button type: "submit", class: "search-button" do %>
          <%= home_icon :search %>
          Найти площадку
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="home-benefits">
  <div class="container benefits-row">
    <div class="benefit-item">
      <span class="benefit-symbol"><%= home_icon :calendar %></span>
      <div>
        <strong>Удобное бронирование</strong>
        <small>Онлайн-заявка за несколько минут</small>
      </div>
    </div>

    <div class="benefit-item">
      <span class="benefit-symbol"><%= home_icon :pin %></span>
      <div>
        <strong>Разные локации</strong>
        <small>Адреса и пространства в любых точках города</small>
      </div>
    </div>

    <div class="benefit-item">
      <span class="benefit-symbol"><%= home_icon :users %></span>
      <div>
        <strong>Для любых форматов</strong>
        <small>От деловой встречи до крупной конференции</small>
      </div>
    </div>

    <div class="benefit-item">
      <span class="benefit-symbol"><%= home_icon :check %></span>
      <div>
        <strong>Актуальная доступность</strong>
        <small>Расписание и свободные даты</small>
      </div>
    </div>
  </div>
</section>

<section class="home-venues">
  <div class="container">
    <div class="home-section-heading">
      <h2>Популярные площадки</h2>
    </div>

    <% if @popular_venues.any? %>
      <div class="home-venues-grid">
      <% @popular_venues.each do |venue| %>
        <article class="home-venue-card">
          <div class="home-venue-photo">
            <% photo =
              case venue.name.to_s.downcase
              when /конференц/
                "venue-conference.jpg"
              when /переговор/
                "venue-meeting.jpg"
              when /семинар/
                "venue-seminar.jpg"
              else
                "venue-default.jpg"
              end
            %>

            <%= image_tag photo, alt: venue.name, loading: "lazy", decoding: "async" %>
          </div>

          <div class="home-venue-info">
            <h3><%= venue.name %></h3>
            <p><%= home_icon :pin %><span><%= venue.address %></span></p>
            <p><%= home_icon :users %><span>До <%= venue.capacity %> гостей</span></p>
          </div>
        </article>
      <% end %>
      </div>
    <% end %>

    <div class="home-cta">
      <div class="home-cta-icon"><%= home_icon :calendar %></div>
      <div class="home-cta-text">
        <h3>Ваше следующее событие начинается здесь</h3>
        <p>Найдите идельное пространство для вашего мероприятия</p>
      </div>
      <%= link_to "Перейти в каталог площадок →", venues_path,
                  class: "home-cta-button" %>
    </div>
  </div>
</section>
