
<% content_for :title, "Вход — EventSpace" %>

<section class="auth-section">
  <div class="auth-card">
    <div class="auth-heading">
      <h1>Вход в EventSpace</h1>
    </div>

    <% if alert.present? %>
      <p class="flash-message flash-error" role="alert"><%= alert %></p>
    <% end %>

    <%= form_with url: login_path, method: :post,
                  class: "auth-form" do |f| %>

      <div class="auth-field">
        <%= f.label :email, "Электронная почта" %>
        <%= f.email_field :email,
              value: @email,
              placeholder: "example@mail.ru",
              autocomplete: "username",
              required: true %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "Пароль" %>
        <%= f.password_field :password,
              placeholder: "Введите пароль",
              autocomplete: "current-password",
              required: true %>
      </div>

      <%= f.submit "Войти", class: "auth-submit" %>
    <% end %>

    <div class="auth-bottom">
      Ещё нет аккаунта?
      <%= link_to "Зарегистрироваться", signup_path %>
    </div>
  </div>
</section>
