<%# GET-форма сохраняет фильтры в адресе каталога. %>
<div class="hero-search">
  <%= form_with url: venues_path, method: :get, local: true, class: "search-form" do |form| %>
    <div class="search-field">
      <%= home_icon :pin %>
      <div class="search-field-content">
        <%= form.label :city, "Город" %>
        <%= form.collection_select :city, cities, :id, :name, include_blank: "Все города", selected: filters[:city] %>
      </div>
    </div>

    <div class="search-field search-date">
      <%= home_icon :calendar %>
      <div class="search-field-content">
        <%= form.label :date, "Дата мероприятия" %>
        <%= form.date_field :date, value: filters[:date], min: Date.current %>
      </div>
    </div>

    <div class="search-field">
      <%= home_icon :users %>
      <div class="search-field-content">
        <%= form.label :guests, "Количество гостей" %>
        <%= form.number_field :guests, value: filters[:guests], min: 1, placeholder: "Любое" %>
      </div>
    </div>

    <%= form.button type: "submit", class: "search-button" do %>
      <%= home_icon :search %>
      Найти площадку
    <% end %>
  <% end %>
</div>
