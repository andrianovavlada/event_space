<% content_for :title, "Площадки — EventSpace" %>

<section class="container venue-catalog">
  <h1>Площадки</h1>
  <%= render "search", cities: @cities, filters: @filters %>

  <% if @filters.values.any?(&:present?) %>
    <p><%= link_to "Сбросить фильтры", venues_path, class: "text-link" %></p>
  <% end %>

  <% if @filter_errors.present? %>
    <div role="alert" class="flash-message flash-error">
      <% @filter_errors.each do |error| %>
        <p><%= error %></p>
      <% end %>
    </div>
  <% elsif @venues.any? %>
    <%= render "cards", venues: @venues, filters: @filters.compact_blank %>
  <% else %>
    <p class="empty-state">Площадки по выбранным параметрам не найдены.</p>
  <% end %>
</section>
